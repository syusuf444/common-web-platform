    {
      "name": "Authentication",
      "item": [
        {
          "name": "Get a request token for cookie-authenticated state changes",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/auth/csrf",
            "description": ""
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  pm.collectionVariables.set('csrfToken', pm.response.json().requestToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Sign in and issue a short-lived HTTP-only session cookie",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-CSRF-TOKEN",
                "value": "{{csrfToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/login",
            "description": "Before submitting, call GET /api/v1/auth/csrf and retain its CWP.AntiForgery cookie. Send the returned requestToken in the X-CSRF-TOKEN header and include that same cookie with this request.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Refresh CSRF token after login",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/auth/csrf",
            "description": ""
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  pm.collectionVariables.set('csrfToken', pm.response.json().requestToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Read the current signed-in user",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/auth/me",
            "description": ""
