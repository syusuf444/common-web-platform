@Platform.Api_HostAddress = http://localhost:5247

GET {{Platform.Api_HostAddress}}/health
Accept: application/json

###

# Authenticate with the login flow documented in docs/MarkDowns/LocalDevelopment.md.
# Supply the authenticated cookies, antiforgery request token, and an authorized tenant ID below.
@tenantId = 00000000-0000-0000-0000-000000000000
@membershipId = 00000000-0000-0000-0000-000000000000
@roleId = 00000000-0000-0000-0000-000000000000
@fileId = 00000000-0000-0000-0000-000000000000
@csrfToken = replace-with-request-token
@authCookie = replace-with-CWP.Auth-cookie-value
@antiForgeryCookie = replace-with-CWP.AntiForgery-cookie-value

GET {{Platform.Api_HostAddress}}/api/v1/tenant/members
Accept: application/json
X-Tenant-ID: {{tenantId}}
Cookie: CWP.Auth={{authCookie}}; CWP.AntiForgery={{antiForgeryCookie}}

###

GET {{Platform.Api_HostAddress}}/api/v1/tenant/members/{{membershipId}}
Accept: application/json
X-Tenant-ID: {{tenantId}}
Cookie: CWP.Auth={{authCookie}}; CWP.AntiForgery={{antiForgeryCookie}}

###

GET {{Platform.Api_HostAddress}}/api/v1/tenant/audit?skip=0&take=50
Accept: application/json
X-Tenant-ID: {{tenantId}}
Cookie: CWP.Auth={{authCookie}}; CWP.AntiForgery={{antiForgeryCookie}}

###

GET {{Platform.Api_HostAddress}}/api/v1/tenant/notifications?take=50
Accept: application/json
X-Tenant-ID: {{tenantId}}
Cookie: CWP.Auth={{authCookie}}; CWP.AntiForgery={{antiForgeryCookie}}

###

POST {{Platform.Api_HostAddress}}/api/v1/tenant/notifications
Accept: application/json
Content-Type: application/json
X-Tenant-ID: {{tenantId}}
X-CSRF-TOKEN: {{csrfToken}}
Cookie: CWP.Auth={{authCookie}}; CWP.AntiForgery={{antiForgeryCookie}}

{
  "recipient": "client@example.local",
  "subject": "Your demo workspace is ready",
  "body": "This notification is stored in the local outbox. No email is sent."
}

###

GET {{Platform.Api_HostAddress}}/api/v1/tenant/notifications/00000000-0000-0000-0000-000000000000
Accept: application/json
X-Tenant-ID: {{tenantId}}
Cookie: CWP.Auth={{authCookie}}; CWP.AntiForgery={{antiForgeryCookie}}

###

GET {{Platform.Api_HostAddress}}/api/v1/tenant/settings
Accept: application/json
X-Tenant-ID: {{tenantId}}
Cookie: CWP.Auth={{authCookie}}; CWP.AntiForgery={{antiForgeryCookie}}

###

GET {{Platform.Api_HostAddress}}/api/v1/tenant/settings/ui.theme
Accept: application/json
X-Tenant-ID: {{tenantId}}
Cookie: CWP.Auth={{authCookie}}; CWP.AntiForgery={{antiForgeryCookie}}

###

POST {{Platform.Api_HostAddress}}/api/v1/tenant/settings
Accept: application/json
Content-Type: application/json
X-Tenant-ID: {{tenantId}}
X-CSRF-TOKEN: {{csrfToken}}
Cookie: CWP.Auth={{authCookie}}; CWP.AntiForgery={{antiForgeryCookie}}

{
  "key": "ui.theme",
  "value": "dark"
}

###

PUT {{Platform.Api_HostAddress}}/api/v1/tenant/settings/ui.theme
Accept: application/json
Content-Type: application/json
X-Tenant-ID: {{tenantId}}
X-CSRF-TOKEN: {{csrfToken}}
Cookie: CWP.Auth={{authCookie}}; CWP.AntiForgery={{antiForgeryCookie}}

{
  "value": "light"
}

###

DELETE {{Platform.Api_HostAddress}}/api/v1/tenant/settings/ui.theme
X-Tenant-ID: {{tenantId}}
X-CSRF-TOKEN: {{csrfToken}}
Cookie: CWP.Auth={{authCookie}}; CWP.AntiForgery={{antiForgeryCookie}}

###

POST {{Platform.Api_HostAddress}}/api/v1/tenant/memberships
Accept: application/json
Content-Type: application/json
X-Tenant-ID: {{tenantId}}
X-CSRF-TOKEN: {{csrfToken}}
Cookie: CWP.Auth={{authCookie}}; CWP.AntiForgery={{antiForgeryCookie}}

{
  "email": "existing-user@example.local"
}

###

PUT {{Platform.Api_HostAddress}}/api/v1/tenant/memberships/{{membershipId}}/status
Accept: application/json
Content-Type: application/json
X-Tenant-ID: {{tenantId}}
X-CSRF-TOKEN: {{csrfToken}}
Cookie: CWP.Auth={{authCookie}}; CWP.AntiForgery={{antiForgeryCookie}}

{
  "status": "Suspended"
}

###

POST {{Platform.Api_HostAddress}}/api/v1/tenant/memberships/{{membershipId}}/roles/{{roleId}}
X-Tenant-ID: {{tenantId}}
X-CSRF-TOKEN: {{csrfToken}}
Cookie: CWP.Auth={{authCookie}}; CWP.AntiForgery={{antiForgeryCookie}}

###

DELETE {{Platform.Api_HostAddress}}/api/v1/tenant/memberships/{{membershipId}}/roles/{{roleId}}
X-Tenant-ID: {{tenantId}}
X-CSRF-TOKEN: {{csrfToken}}
Cookie: CWP.Auth={{authCookie}}; CWP.AntiForgery={{antiForgeryCookie}}

###

GET {{Platform.Api_HostAddress}}/api/v1/tenant/files
Accept: application/json
X-Tenant-ID: {{tenantId}}
Cookie: CWP.Auth={{authCookie}}; CWP.AntiForgery={{antiForgeryCookie}}

###

GET {{Platform.Api_HostAddress}}/api/v1/tenant/files/{{fileId}}
Accept: application/json
X-Tenant-ID: {{tenantId}}
Cookie: CWP.Auth={{authCookie}}; CWP.AntiForgery={{antiForgeryCookie}}

###

GET {{Platform.Api_HostAddress}}/api/v1/tenant/files/{{fileId}}/content
X-Tenant-ID: {{tenantId}}
Cookie: CWP.Auth={{authCookie}}; CWP.AntiForgery={{antiForgeryCookie}}

###

# Send multipart/form-data with a "file" field using the REST Client's file-upload support.
POST {{Platform.Api_HostAddress}}/api/v1/tenant/files
X-Tenant-ID: {{tenantId}}
X-CSRF-TOKEN: {{csrfToken}}
Cookie: CWP.Auth={{authCookie}}; CWP.AntiForgery={{antiForgeryCookie}}
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="file"; filename="sample.pdf"
Content-Type: application/pdf

< ./sample.pdf
--WebAppBoundary--

###
